<%- include('../partials/header') %>
<h1><%= emp ? 'Edit employee' : 'New employee' %></h1>
<form method="post" action="<%= BASE_PATH %>/employees/save" class="form-tabs">
  <% if (emp) { %><input type="hidden" name="id" value="<%= emp.id %>"><% } %>
  <% if (user.role === 'super_admin') { %>
    <label>Company
      <select name="company_id" required>
        <% companies.forEach(c => { %>
          <option value="<%= c.id %>" <%= (emp ? emp.company_id : companyId)===c.id?'selected':'' %>><%= c.name %></option>
        <% }) %>
      </select>
    </label>
  <% } else { %>
    <input type="hidden" name="company_id" value="<%= companyId %>">
  <% } %>

  <div class="tabs">
    <input type="radio" name="tab" id="t1" checked><label for="t1">Personal</label>
    <input type="radio" name="tab" id="t2"><label for="t2">Employment</label>
    <input type="radio" name="tab" id="t3"><label for="t3">Banking</label>
    <input type="radio" name="tab" id="t4"><label for="t4">Compensation</label>
    <input type="radio" name="tab" id="t6"><label for="t6">Allowances</label>
    <input type="radio" name="tab" id="t7"><label for="t7">Deductions</label>
    <input type="radio" name="tab" id="t5"><label for="t5">Access &amp; payouts</label>

    <section class="tab1">
      <label>First name <input name="first_name" value="<%= emp?.first_name || '' %>" required></label>
      <label>Last name  <input name="last_name"  value="<%= emp?.last_name  || '' %>" required></label>
      <label>Email      <input name="email" type="email" value="<%= emp?.email || '' %>"></label>
      <label>Gender
        <select name="gender">
          <option value=""></option>
          <% ['M','F','X'].forEach(g => { %><option value="<%= g %>" <%= emp?.gender===g?'selected':'' %>><%= g %></option><% }) %>
        </select>
      </label>
      <label>Date of birth <input name="dob" type="date" value="<%= emp?.dob || '' %>"></label>
      <label>Address    <textarea name="address"><%= emp?.address || '' %></textarea></label>
      <label>Dependents <input name="dependents" type="number" min="0" value="<%= emp?.dependents ?? 0 %>"></label>
    </section>
    <section class="tab2">
      <label>Department <input name="department_name" list="dept-list" value="<%= emp?.dept_name || '' %>">
        <datalist id="dept-list"><% departments.forEach(d => { %><option value="<%= d.name %>"><% }) %></datalist>
      </label>
      <label>Job function <input name="job_function_name" list="job-list" value="<%= emp?.job_name || '' %>">
        <datalist id="job-list"><% jobFunctions.forEach(j => { %><option value="<%= j.name %>"><% }) %></datalist>
      </label>
      <label>Start date <input name="start_date" type="date" value="<%= emp?.start_date || '' %>"></label>
      <label>End date   <input name="end_date"   type="date" value="<%= emp?.end_date   || '' %>"></label>
      <label>Active <input name="is_active" type="checkbox" <%= (emp?.is_active ?? 1)?'checked':'' %>></label>
    </section>
    <section class="tab3">
      <p class="hint">Split this employee's net pay across one or more accounts. Percentages must sum to <strong>100</strong>.</p>
      <table id="bank-accounts-table" class="data" style="background:#fcfcfd">
        <thead><tr>
          <th>Bank</th><th>Branch</th><th>Account #</th><th>Account name</th><th>%</th><th></th>
        </tr></thead>
        <tbody>
        <% const accts = (emp && emp.bank_accounts && emp.bank_accounts.length) ? emp.bank_accounts : [{}]; %>
        <% accts.forEach((a, i) => { %>
          <tr class="ba-row">
            <td><select name="ba_bank_id">
              <option value=""></option>
              <% banks.forEach(b => { %>
                <option value="<%= b.id %>"
                  <%= a.bank_id && (a.bank_id.toString ? a.bank_id.toString() : a.bank_id)===b.id ? 'selected':'' %>>
                  <%= b.name %>
                </option>
              <% }) %>
            </select></td>
            <td><input name="ba_branch"       value="<%= a.branch_code || '' %>" size="6" placeholder="307"></td>
            <td><input name="ba_account_no"   value="<%= a.account_no  || '' %>" required></td>
            <td><input name="ba_account_name" value="<%= a.account_name|| '' %>"></td>
            <td><input name="ba_pct"          value="<%= a.percentage  ?? (accts.length===1?100:0) %>" type="number" step="0.01" min="0" max="100" size="5" class="ba-pct" required></td>
            <td><button type="button" class="ba-remove" title="Remove">×</button></td>
          </tr>
        <% }) %>
        </tbody>
        <tfoot><tr><td colspan="4" style="text-align:right">Total %</td>
          <td><span id="ba-total" class="num">0</span></td>
          <td><button type="button" id="ba-add">+ Add account</button></td></tr></tfoot>
      </table>
    </section>
    <section class="tab4">
      <label>Pay type
        <select name="pay_type" required>
          <option value="hourly" <%= emp?.pay_type==='hourly'?'selected':'' %>>Hourly</option>
          <option value="salary" <%= emp?.pay_type==='salary'?'selected':'' %>>Salary</option>
        </select>
      </label>
      <label>Annual salary <input name="annual_salary" type="number" step="0.01" value="<%= emp?.annual_salary || '' %>"></label>
      <label>Hourly rate   <input name="hourly_rate"   type="number" step="0.01" value="<%= emp?.hourly_rate   || '' %>"></label>
      <label>Default hours (per period) <input name="default_hours" type="number" step="0.5" value="<%= emp?.default_hours || '' %>" placeholder="company default"></label>
      <label>FTE % <input name="fte_pct" type="number" step="0.1" value="<%= emp?.fte_pct ?? 100 %>"></label>
    </section>
    <section class="tab6">
      <p class="hint">Taxable allowances added to gross each pay period. PNG IRC treats these as part of salary or wages.</p>
      <label>Housing <input name="housing_allowance" type="number" step="0.01" value="<%= emp?.housing_allowance || 0 %>"></label>
      <label>Vehicle <input name="vehicle_allowance" type="number" step="0.01" value="<%= emp?.vehicle_allowance || 0 %>"></label>
      <label>Fuel <input name="fuel_allowance" type="number" step="0.01" value="<%= emp?.fuel_allowance || 0 %>"></label>
      <label>Meals <input name="meals_allowance" type="number" step="0.01" value="<%= emp?.meals_allowance || 0 %>"></label>
      <label>School fees <input name="school_fees_allowance" type="number" step="0.01" value="<%= emp?.school_fees_allowance || 0 %>"></label>
      <label>Leave fares <input name="leave_fares_allowance" type="number" step="0.01" value="<%= emp?.leave_fares_allowance || 0 %>"></label>
      <label>Electricity <input name="electricity_allowance" type="number" step="0.01" value="<%= emp?.electricity_allowance || 0 %>"></label>
      <label>Gas <input name="gas_allowance" type="number" step="0.01" value="<%= emp?.gas_allowance || 0 %>"></label>
      <label>Phone <input name="phone_allowance" type="number" step="0.01" value="<%= emp?.phone_allowance || 0 %>"></label>
      <label>Airfares <input name="airfares_allowance" type="number" step="0.01" value="<%= emp?.airfares_allowance || 0 %>"></label>
      <label>Extra <input name="extra_allowance" type="number" step="0.01" value="<%= emp?.extra_allowance || 0 %>"></label>
    </section>
    <section class="tab7">
      <p class="hint">Pre-tax deductions reduce the taxable amount. Post-tax deductions reduce net only.</p>
      <fieldset><legend>Pre-tax</legend>
        <label>Salary sacrifice <input name="salary_sacrifice" type="number" step="0.01" value="<%= emp?.salary_sacrifice || 0 %>"></label>
        <label>NCSL voluntary <input name="ncsl_voluntary" type="number" step="0.01" value="<%= emp?.ncsl_voluntary || 0 %>"></label>
        <label>NAS extra % <input name="nas_extra_pct" type="number" step="0.1" value="<%= emp?.nas_extra_pct || 0 %>"></label>
      </fieldset>
      <fieldset><legend>Post-tax</legend>
        <label>Savings <input name="savings_deduction" type="number" step="0.01" value="<%= emp?.savings_deduction || 0 %>"></label>
        <label>Christmas <input name="christmas_bonus" type="number" step="0.01" value="<%= emp?.christmas_bonus || 0 %>"></label>
        <label>Loan repayment <input name="loan_repayment" type="number" step="0.01" value="<%= emp?.loan_repayment || 0 %>"></label>
        <label>Education <input name="education_deduction" type="number" step="0.01" value="<%= emp?.education_deduction || 0 %>"></label>
      </fieldset>
      <label>Employee notes (admin-visible only) <textarea name="employee_notes"><%= emp?.employee_notes || '' %></textarea></label>
    </section>
    <section class="tab5">
      <label>Clearance level
        <select name="clearance_level">
          <option value="0" <%= (emp?.clearance_level||0)===0?'selected':'' %>>0 — regular employee (visible to all admins)</option>
          <% if (user.clearance_level >= 2) { %>
            <option value="1" <%= emp?.clearance_level===1?'selected':'' %>>1 — site key person</option>
          <% } %>
          <% if (user.clearance_level >= 3) { %>
            <option value="2" <%= emp?.clearance_level===2?'selected':'' %>>2 — bookkeeper</option>
          <% } %>
          <% if (user.clearance_level >= 4) { %>
            <option value="3" <%= emp?.clearance_level===3?'selected':'' %>>3 — principal</option>
            <option value="4" <%= emp?.clearance_level===4?'selected':'' %>>4 — system owner</option>
          <% } %>
        </select>
      </label>
      <p class="hint">Users at this clearance and below can see this employee's record. Set ≥2 to hide pay rate from bookkeepers.</p>
      <label>Is payroll admin (legacy) <input name="is_payroll_admin" type="checkbox" <%= emp?.is_payroll_admin?'checked':'' %>></label>
      <label>Is company admin (legacy) <input name="is_company_admin" type="checkbox" <%= emp?.is_company_admin?'checked':'' %>></label>
      <label>Payroll share % <input name="payroll_share_pct" type="number" step="0.01" value="<%= emp?.payroll_share_pct ?? 0 %>"></label>
      <p class="hint">Master-user payouts: this employee receives this % of total payroll each run. (Service-fee recipients like Theresia and Richard go through Admin → Service fees instead.)</p>
    </section>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn-primary">Save</button>
    <a href="<%= BASE_PATH %>/employees<%= companyId ? '?company='+companyId : '' %>">Cancel</a>
  </div>
</form>
<script src="<%= BASE_PATH %>/static/js/bank-accounts.js"></script>
<%- include('../partials/footer') %>
