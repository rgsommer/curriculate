# Android release signing — copy this file to `keystore.properties` (same dir)
# and fill in the real values. keystore.properties is git-ignored; never commit it.
#
# Generate the upload keystore first (run from mobile-app-pngpay/android/):
#   keytool -genkey -v -keystore pngpay-upload-key.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias pngpay
#
# Back up pngpay-upload-key.jks + these passwords somewhere safe. With Play App
# Signing (default), Google holds the app signing key and this is your UPLOAD
# key — if lost, you can request an upload-key reset from Play Console.

storeFile=pngpay-upload-key.jks
storePassword=CHANGE_ME
keyAlias=pngpay
keyPassword=CHANGE_ME
