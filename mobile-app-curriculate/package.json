{
  "name": "qrewzi-teacher",
  "version": "1.0.0",
  "description": "Qrewzi Teacher — GameMaster experience for live classroom sessions (Android + iOS Capacitor shell)",
  "private": true,
  "scripts": {
    "build:web": "mkdir -p www && cp src/index.html www/index.html",
    "cap:init": "npx cap init 'Qrewzi Teacher' net.curriculate.sessions --web-dir www",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npm run build:web && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:run:android": "npm run cap:sync && npx cap run android",
    "icons": "npx capacitor-assets generate --iconBackgroundColor '#0f172a' --splashBackgroundColor '#0b1024'"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.0",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/network": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/screen-orientation": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.0",
    "@capacitor/cli": "^6.0.0"
  }
}
