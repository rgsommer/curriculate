{
  "name": "curriculate-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Curriculate cloud backend (Express + MongoDB + Socket.io)",
  "scripts": {
    "build": "npm run build-all",
    "build-all": "cd ../student-app && npm install && npm run build && cd ../teacher-app && npm install && npm run build",
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "start:prod": "node index.js",
    "pm2:start": "npx pm2 start index.js --name curriculate-backend --update-env",
    "pm2:stop": "npx pm2 stop curriculate-backend || true",
    "pm2:restart": "npx pm2 restart curriculate-backend || true",
    "pm2:logs": "npx pm2 logs curriculate-backend --lines 200",
    "test:socket": "node scripts/socket_test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.958.0",
    "@aws-sdk/s3-request-presigner": "^3.958.0",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.8",
    "openai": "^4.54.1",
    "papaparse": "^5.5.3",
    "pdfkit": "^0.15.0",
    "react-confetti": "^6.4.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "stripe": "^20.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "jest": "^29.6.4",
    "nodemon": "^3.1.3",
    "pm2": "^6.0.11"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  },
  "engines": {
    "node": ">=18.x"
  },
  "keywords": [
    "express",
    "mongodb",
    "socket.io",
    "curriculate",
    "api"
  ],
  "author": "Curriculate",
  "license": "MIT"
}
