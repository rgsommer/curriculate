# ============================================================
#  Curriculate Backend — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git.
# ============================================================

# ── Server ──────────────────────────────────────────────────
NODE_ENV=production
PORT=10000

# ── MongoDB ─────────────────────────────────────────────────
# Full connection string (Atlas or self-hosted)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/curriculate?retryWrites=true&w=majority

# ── JWT ─────────────────────────────────────────────────────
# Must be a long random secret. Generate with: openssl rand -hex 64
JWT_SECRET=replace_with_at_least_64_random_characters

# ── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Optional model overrides (defaults to gpt-4o if unset)
OPENAI_MODEL=gpt-4o
AI_TASK_MODEL=gpt-4o
AI_SUMMARY_MODEL=gpt-4o-mini

# ── Flight search (/travel) ─────────────────────────────────
# Uses the Anthropic web_search tool — no dedicated flight API.
# Requires ANTHROPIC_API_KEY (shared with /stocks). Optional model override:
TRAVEL_SEARCH_MODEL=claude-sonnet-4-6
# Emailing results uses RESEND_API_KEY (shared). Optional from-address override:
TRAVEL_FROM=Curriculate Flights <noreply@curriculate.net>

# ── ElevenLabs (text-to-speech) ─────────────────────────────
ELEVENLABS_API_KEY=

# ── AWS S3 (audio / media uploads) ─────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ── Stripe (payments / subscriptions) ───────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CHECKOUT_SUCCESS_URL=https://set.curriculate.net/billing/success
STRIPE_CHECKOUT_CANCEL_URL=https://set.curriculate.net/billing
STRIPE_PORTAL_RETURN_URL=https://set.curriculate.net/billing

# ── Email / SMTP ─────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=SG....
EMAIL_FROM=noreply@curriculate.net
EMAIL_FROM_ADDRESS=noreply@curriculate.net
EMAIL_FROM_NAME=Curriculate
EMAIL_REPLY_TO=support@curriculate.net
EMAIL_SUBJECT_PREFIX=[Curriculate]

# ── App URLs (used in emails and reset links) ────────────────
APP_BASE_URL=https://set.curriculate.net
TEACHER_APP_URL=https://set.curriculate.net
TEACHER_APP_ORIGIN=https://set.curriculate.net

# ── Admin / internal keys ────────────────────────────────────
# Random secret for internal admin endpoints
ADMIN_KEY=replace_with_random_secret
ADMIN_API_TOKEN=replace_with_random_token

# ── Demo mode (optional) ─────────────────────────────────────
DEMO_ADMIN_KEY=
DEMO_VOCAB=
DEMO_SUBJECT=
DEMO_GRADE_LEVEL=

# ── Feature flags / misc ─────────────────────────────────────
# Number of days for free trial (default: 14)
TRIAL_DAYS=14

# Usage threshold for "power user" analytics flag
POWER_USER_THRESHOLD=50

# Seconds after task ends before results are finalised
POST_SUBMIT_SECONDS=3

# Analytics cache TTL in milliseconds
USAGE_SUMMARY_CACHE_TTL_MS=300000

# Set to "true" in development to return password reset tokens in API responses
RETURN_RESET_TOKEN=false

# Cookie domain for auth cookies (set to .curriculate.net for production)
CURRICULATE_COOKIE_DOMAIN=.curriculate.net
